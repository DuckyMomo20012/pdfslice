{
  "name": "pdfslice",
  "type": "module",
  "version": "1.0.0",
  "description": "Split, gather, and verify PDF <-> page-image sets",
  "author": "DuckyMomo20012",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuckyMomo20012/pdfslice.git"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/cli.d.mts",
        "require": "./dist/cli.d.cts"
      },
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cli.cjs",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.mts",
  "bin": {
    "pdfslice": "./dist/cli.mjs",
    "__pdfslice_bash_complete": "./dist/bash-complete.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "postinstall": "npx @stricli/auto-complete@latest install pdfslice --bash __pdfslice_bash_complete"
  },
  "dependencies": {
    "@stricli/auto-complete": "1.3.0",
    "@stricli/core": "1.3.0",
    "pdf-lib": "1.17.1",
    "pdf-to-img": "6.2.0",
    "sharp": "0.35.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.2.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "4.1.11",
    "eslint": "10.9.0",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
